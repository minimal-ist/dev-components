# Contact form delivery.
#
# Web3Forms posts the enquiry straight to a mailbox with no backend of our own.
# Create a free access key at https://web3forms.com, put it here in a local
# .env file, and set the same variable in the host's environment at deploy.
#
# Without this key the enquiry form tells the visitor to call or WhatsApp
# instead — it never fails silently.
VITE_WEB3FORMS_ACCESS_KEY=
